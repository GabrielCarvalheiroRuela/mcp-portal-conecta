# Copie para .env (ou cadastre estas variáveis na stack do Portainer). O .env não vai para o git; este arquivo vai.
# Nunca preencha credenciais aqui.

# O MCP não tem endereço público: só a rede Docker (n8n e portal o chamam por http://mcp-funcionalidades:3002).
# Deixe vazio. Só preencha se um dia ele ganhar DNS (https://<host>/mcp), para o botão "Conectar MCP" do portal.
MCP_URL_PUBLICA=
MCP_FUNCIONALIDADES_URL=
MCP_FUNCIONALIDADES_TOKEN=

# Gere com: openssl rand -hex 32   (o servidor recusa menos de 32 caracteres)
MCP_TOKEN=

# API do Monint (a mesma que o portal usa, sem barra no fim). O botão "Conectar MCP" do portal pede o token ao MCP, e o
# MCP só o entrega depois de perguntar a ela (GET /usuarios/me) se quem pediu é DEV ou ADM.
MONITORAMENTO_API_URL=

# Banco do Monint: host, porta e base do DATABASE_URL da API (jdbc:mysql://HOST:PORTA/BASE).
DB_HOST=
DB_PORT=3306
DB_NAME=
# Usuário mcp_func criado no fim do sql/003_funcionalidades.sql, com SELECT só nas views VW_*.
# Não use o usuário da API aqui: ele escreve em todas as tabelas.
DB_USER=mcp_func
DB_PASSWORD=
